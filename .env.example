# Copy this to .env and fill in your real values
# ===== WARNING: Never commit .env to git =====

# Pexels API Key for dynamic image search
PEXELS_API_KEY=your_pexels_api_key

# OpenAI API Key for AI content generation
OPENAI_API_KEY=sk-your-openai-key

# Google Search Console (OAuth2 Method)
GSC_CLIENT_ID=your-gsc-client-id
GSC_CLIENT_SECRET=your-gsc-client-secret
GSC_REFRESH_TOKEN=your-gsc-refresh-token
GSC_SITE_URL=https://usmantrades.co.uk

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Dashboard Password (used for admin panel login)
DASHBOARD_PASSWORD=your-secure-password

# Cron Secret (used by Vercel Cron Jobs)
CRON_SECRET=your-cron-secret
